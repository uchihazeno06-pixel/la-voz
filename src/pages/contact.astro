---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../../site.config';
---

<BaseLayout title="Contact" description={`Get in touch with ${siteConfig.author}.`}>
  <article class="contact">
    <h1 class="contact-title">Contact</h1>
    <p class="contact-sub">
      Reach out by email, or use the form below.
    </p>

    <p class="email-line">
      <a href={`mailto:${siteConfig.email}`} class="email">{siteConfig.email}</a>
    </p>

    <form
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="contact-form"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p hidden>
        <label>Don't fill this out: <input name="bot-field" /></label>
      </p>

      <label class="field">
        <span class="field-label">Name</span>
        <input type="text" name="name" required class="input" />
      </label>

      <label class="field">
        <span class="field-label">Email</span>
        <input type="email" name="email" required class="input" />
      </label>

      <label class="field">
        <span class="field-label">Message</span>
        <textarea name="message" rows="6" required class="input"></textarea>
      </label>

      <button type="submit" class="submit">Send</button>
    </form>
  </article>
</BaseLayout>

<style>
  .contact { max-width: 60ch; margin: 0 auto; }
  .contact-title {
    font-family: theme('fontFamily.serif');
    font-size: 2.5rem;
    letter-spacing: -0.03em;
    font-weight: 700;
    margin: 0 0 0.75rem;
  }
  .contact-sub { color: var(--color-muted); margin: 0 0 1.5rem; }
  .email-line { margin-bottom: 2.5rem; }
  .email { font-size: 1.05rem; }

  .contact-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .field { display: flex; flex-direction: column; gap: 0.4rem; }
  .field-label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }
  .input {
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    border-radius: 6px;
    font-size: 0.95rem;
    font-family: inherit;
    resize: vertical;
  }
  .input:focus { outline: none; border-color: var(--color-accent); }
  .submit {
    align-self: flex-start;
    padding: 0.75rem 1.5rem;
    background: var(--color-accent);
    color: #fff;
    border: none;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s;
  }
  .submit:hover { background: var(--color-accent-hover); }
</style>