---
interface Props {
  size?: number;
  class?: string;
  /** When true, uses currentColor so it inherits text color from context */
  inherit?: boolean;
  /** Optional accent color (defaults to currentColor) */
  accent?: string;
}
const {
  size = 32,
  class: className = '',
  inherit = true,
  accent,
} = Astro.props;

const fill = inherit ? 'currentColor' : (accent || '#0a0a0a');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  fill={fill}
  class={className}
  role="img"
  aria-label="La Voz eagle mark"
>
  <!-- Left wing: 4 faceted feather planes -->
  <path d="M30 28 L6 12 L10 22 L2 21 L12 30 L6 36 L26 34 Z"/>
  <!-- Right wing: mirrored -->
  <path d="M34 28 L58 12 L54 22 L62 21 L52 30 L58 36 L38 34 Z"/>
  <!-- Body -->
  <path d="M32 20 L26 34 L32 48 L38 34 Z"/>
  <!-- Head -->
  <path d="M32 10 L26 20 L32 25 L38 20 Z"/>
  <!-- Beak -->
  <path d="M38 18 L46 20 L38 22 Z"/>
  <!-- Tail feathers -->
  <path d="M27 48 L25 58 L29 55 L32 61 L35 55 L39 58 L37 48 Z"/>
</svg>