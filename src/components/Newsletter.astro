---
import { siteConfig } from '../../site.config';
const show = siteConfig.buttondownUsername !== '';
---

{show && (
  <section class="newsletter" aria-label="Newsletter signup">
    <div class="nl-inner">
      <div class="nl-text">
        <h3 class="nl-title">Get new posts by email</h3>
        <p class="nl-sub">No spam. Unsubscribe anytime.</p>
      </div>
      <form
        class="nl-form"
        action={`https://buttondown.email/api/emails/embed-subscribe/${siteConfig.buttondownUsername}`}
        method="post"
        target="popupwindow"
        onsubmit="window.open('https://buttondown.email/${siteConfig.buttondownUsername}', 'popupwindow')"
      >
        <input
          type="email"
          name="email"
          placeholder="you@example.com"
          required
          aria-label="Email address"
          class="nl-input"
        />
        <button type="submit" class="nl-btn">Subscribe</button>
      </form>
    </div>
  </section>
)}

<style>
  .newsletter {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    border-radius: 8px;
    padding: 1.75rem;
    margin: 3rem 0;
  }
  .nl-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    justify-content: space-between;
  }
  .nl-title {
    font-family: theme('fontFamily.serif');
    font-size: 1.15rem;
    margin: 0 0 0.25rem;
    color: var(--color-text);
  }
  .nl-sub {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin: 0;
  }
  .nl-form { display: flex; gap: 0.5rem; width: 100%; max-width: 400px; }
  .nl-input {
    flex: 1;
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    border-radius: 6px;
    font-size: 0.9rem;
    font-family: inherit;
  }
  .nl-input:focus {
    outline: none;
    border-color: var(--color-accent);
  }
  .nl-btn {
    padding: 0.6rem 1.1rem;
    background: var(--color-accent);
    color: #fff;
    border: none;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s;
  }
  .nl-btn:hover { background: var(--color-accent-hover); }

  @media (min-width: 640px) {
    .nl-inner { flex-direction: row; align-items: center; }
  }
</style>